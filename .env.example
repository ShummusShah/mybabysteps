# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# RevenueCat Configuration (for premium features)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_key

# Development Server Configuration
# Note: EXPO_PACKAGER_HOSTNAME is automatically set in package.json scripts
# It defaults to your machine's network IP for iOS simulator compatibility
