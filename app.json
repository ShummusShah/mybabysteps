{
  "expo": {
    "name": "MyBabySteps",
    "slug": "mybabysteps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mybabysteps",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mybabysteps.app",
      "supportsTabletMode": true,
      "requiresFullScreen": false
    },
    "android": {
      "package": "com.mybabysteps.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MyBabySteps to access your photos.",
          "cameraPermission": "Allow MyBabySteps to access your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#21B6AD"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
